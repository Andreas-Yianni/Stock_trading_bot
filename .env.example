# Αντέγραψε αυτό το αρχείο σε ".env" και συμπλήρωσε τις τιμές.

# Από τον @BotFather στο Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Το δικό σου chat id (στείλε /start στο bot σου και θα σου το πει).
# Μόνο αυτό το chat θα μπορεί να χρησιμοποιεί το bot.
TELEGRAM_CHAT_ID=

# Αυτόματο PAPER trading στο Alpaca (alpaca.markets → Paper Trading → API Keys → Generate).
# ΜΟΝΟ κλειδιά paper (ξεκινούν από PK). Ενεργοποίηση από το Telegram με /auto on.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Για μελλοντική χρήση (δες PLAN.md)
# ANTHROPIC_API_KEY=
# CRYPTOPANIC_API_KEY=
